# pbmockx persistent mock rules — loaded at daemon start.
# Add/delete through the CLI or Web UI auto-saves this file. You can also edit
# it manually and run `pbmockx rules reload`.
#
# Every rule has: id (auto), type, url_pattern (regex against the full URL).
# Optional: enabled (default true; set false to keep a rule without applying it).
#
# Types
# -----
# patch — change fields in a JSON/protobuf response:
#   path:        field path, e.g. game.name / items[0].id
#   value:       any JSON value (string/number/bool/null/object/array)
#   action:      set (default) | append | insert | remove | unset
#                append/insert/remove target a repeated field (path points at
#                the list itself; insert/remove use `index`)
#                unset deletes the key at `path`
#   index:       index for insert (before) / remove
#   protocol:    optional 'protobuf' | 'json' filter
#
# map_local — replace the whole response:
#   source:      'data' (JSON -> PB encode) | 'file' (raw local file)
#   data_file:   data mode: JSON file under ~/.pbmockx/mock-data/
#   file_path:   file mode: absolute path to serve
#   desc:        optional .desc URL (data mode; otherwise inherited from the
#                response Content-Type)
#   messageType: optional PB message type (data mode)
#   delimited:   true for length-delimited PB streams
#   status:      optional HTTP status override
#   headers:     optional response header overrides
#
# map_remote — rewrite the request target:
#   replacement: full target URL, or a regex replacement string
#                (a bare host/path is treated as https://host/path)
#   is_regex:    true to use String.replace semantics
#
# Execution order
# ---------------
# map_remote -> map_local(file) -> map_local(data) -> patch
#
# Examples (uncomment to enable):

# - type: patch
#   url_pattern: 'api/game'
#   path: 'game.name'
#   value: 'MockedGame'

# - type: patch
#   url_pattern: 'api/game'
#   path: 'game.tags'
#   action: append
#   value: 'new-tag'

# - type: patch
#   url_pattern: 'api/game'
#   path: 'game.list'
#   action: insert
#   index: 1
#   value: { id: 9, name: 'New' }

# - type: patch
#   url_pattern: 'api/game'
#   path: 'game.list'
#   action: remove
#   index: 0

# - type: patch
#   url_pattern: 'api/game'
#   path: 'game.obsolete'
#   action: unset

# - type: map_local
#   url_pattern: 'api/game'
#   source: data
#   data_file: 'a1b2c3d4.json'   # ~/.pbmockx/mock-data/a1b2c3d4.json

# - type: map_local
#   url_pattern: 'files\.mock/.*\.zip'
#   source: file
#   file_path: '/absolute/path/to/mock.zip'
#   status: 200
#   headers:
#     content-type: application/zip

# - type: map_remote
#   url_pattern: 'pub\.example\.com/api/version'
#   replacement: '127.0.0.1:9101/api/version'
#   is_regex: false

# - type: map_remote
#   url_pattern: '^https://old\.example\.com/(.*)$'
#   replacement: 'https://new.example.com/$1'
#   is_regex: true
