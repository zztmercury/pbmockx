{
  "name": "pbmockx",
  "version": "1.1.0",
  "description": "Native HTTP/HTTPS capture proxy with protobuf/JSON mock engine and web UI (no whistle)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zztmercury/pbmockx"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pbmockx": "./bin/pbmockx.js",
    "pbmockxd": "./bin/pbmockxd.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/",
    "dev": "tsc -p tsconfig.json -w",
    "start": "node bin/pbmockxd.js"
  },
  "dependencies": {
    "js-yaml": "^4.0.0",
    "long": "^5.2.0",
    "node-forge": "^1.3.1",
    "protobufjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.0.0"
  }
}
