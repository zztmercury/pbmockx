{
  "name": "pbmockx",
  "version": "1.1.0",
  "description": "Native HTTP/HTTPS capture proxy with protobuf/JSON mock engine and web UI (no whistle)",
  "license": "MIT",
  "keywords": [
    "protobuf",
    "http-proxy",
    "https-proxy",
    "mitm",
    "capture",
    "mock",
    "debug",
    "api-mock",
    "charles",
    "whistle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zztmercury/pbmockx"
  },
  "homepage": "https://github.com/zztmercury/pbmockx#readme",
  "bugs": {
    "url": "https://github.com/zztmercury/pbmockx/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pbmockx": "./bin/pbmockx.js",
    "pbmockxd": "./bin/pbmockxd.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/tests/",
    "web/",
    "skill/",
    "VERSION",
    "rules.yaml.example",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "dev": "tsc -p tsconfig.json -w",
    "start": "node bin/pbmockxd.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "notes": "node scripts/changelog-notes.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "js-yaml": "^4.0.0",
    "long": "^5.2.0",
    "node-forge": "^1.3.1",
    "protobufjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.0.0"
  }
}
